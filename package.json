{
  "name": "markora",
  "version": "1.0.0",
  "private": true,
  "description": "Markora — a privacy-first Markdown viewer for Chrome",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
