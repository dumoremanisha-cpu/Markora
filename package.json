    "@types/chrome": "^0.0.280",
    "@types/markdown-it": "^14.2.0",
    "@types/markdown-it-container": "^4.0.1",
    "@types/markdown-it-footnote": "^3.0.4",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.0",
    "jszip": "^3.10.2",
    "prettier": "^3.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
